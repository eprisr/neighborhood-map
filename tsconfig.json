{
	"compilerOptions": {
		"module": "esnext",
		"moduleResolution": "bundler",
		"strict": true,
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"allowJs": true,
		"target": "es6",
		"jsx": "react-jsx",
		"outDir": "./build",
		"rootDir": "./src",
		"lib": ["dom", "dom.iterable", "esnext"],
		"types": ["google.maps"],
		"typeRoots": ["./node_modules/@types", "./src/types"]
	},
	"include": ["./src"],
	"exclude": ["node_modules"]
}
